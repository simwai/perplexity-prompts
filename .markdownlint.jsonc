{
  "MD060": false,
  "MD013": {
    "line_length": 1000
  },
  // House convention: every module wrapper tag (`<HIGH_PRIO_ENFORCEMENT>`,
  // `<PERSONA: X>`) must precede the H1 so agents scanning for it see it
  // first; a leading tag line is therefore not a missing-heading defect.
  "MD041": false,
  // Changelog convention: version sections repeat `### Added` / `### Changed`
  // headings under different `## [version]` parents; duplicates are only a
  // defect within the same section.
  "MD024": {
    "siblings_only": true
  },
  // Generated session artifacts are not hand-authored source; exclude them
  // from lint so auto-generated formatting does not block the gate.
  "ignores": [
    "SESSION_STATE-*.md"
  ],
  // Protocol files use inline HTML tags (`<MUST>`, `<MUST_NOT>`, `<HIGH_PRIO>`)
  // as hard-guard markers; these are intentional and must not be removed.
  "MD033": false
}