{
// opencode-native config for the Baba prompt system.
// Inert for other agents — AGENTS.md + prompt-system/
// remain the portable copy-paste unit. This file only affects opencode.
  "$schema": "https://opencode.ai/config.json",

  // Guarantees the system core is in every opencode session without relying
  // on the model choosing to read it. Mirrors the AGENTS.md startup instruction.
  // The system is merged; it was 39 files (bootstrap.txt + 38 modules) before the
  // 2026-08-31 cycle-removal pass. Entries here are explicit paths, never globs.
  // AGENTS.md is the sole entry point; prompt-system/ files follow its load order.
  //
  // This array pins the always-load [core] set plus the load-on-PATCH [review] set.
  // 11-triggers.md is core and must stay pinned: it holds every canonical trigger
  // definition, so omitting it silently disables T-01..T-23 routing.
  // Conditional additions (stacks/, designer, doc, logical) are deliberately NOT
  // pinned -- they are diligence-loaded per 00-system.md's load order, so pinning
  // them would load the whole corpus into every session.
  "instructions": [
    "AGENTS.md",
    "prompt-system/00-system.md",
    "prompt-system/11-triggers.md",
    "prompt-system/01-personas.md",
    "prompt-system/02-decision-prompts.md",
    "prompt-system/03-output-and-state.md",
    "prompt-system/04-rubrics.md",
    "prompt-system/05-impl-style.md",
    "prompt-system/06-misc.md",
    "prompt-system/07-protocols.md",
    "prompt-system/08-plan-actual-gate.md"
  ],

  // Prefer the read-only BabaSensei planning path by default. The native Build
  // and Plan overrides in .opencode/agents/ orchestrate the role subagents below.
  "default_agent": "plan",

  // Small model for background tasks (metadata generation, auto-titling, etc.)
  // Uses Kilo's free step-5-preview (kilo3/kilo4 provider) - step-3.7-flash is dead
  "small_model": "step-5-preview-free",

  // Loop protection: hard-stop repeated identical tool calls (doom loops).
  // opencode fires doom_loop detection on 3+ consecutive identical calls and
  // would default to "ask"; denying it halts the loop at the process level
  // instead of auto-approving under permissive setups. Guards credit burn on
  // loop-prone models (Grok-class). Native opencode protection only.
  "permission": {
    "doom_loop": "deny",
    "git_remote": "deny",
    "git_push_force": "deny",
    "env_files": "deny",
    "pem_files": "deny",
    "key_files": "deny"
  },

  // Plugin debug output needs no config here. The config schema sets
  // additionalProperties: false and declares no `env` property, so an `env`
  // block was silently dropped and never reached process.env -- that is why
  // baba-debug.jsonl never appeared. .opencode/lib/baba-debug.ts now defaults
  // the JSONL sink to %TEMP%\baba-debug.jsonl. Console and the in-app log
  // viewer are always on. To retune, set these as real OS environment
  // variables before launching opencode:
  //   BABA_DEBUG_FILE    -- override the JSONL path
  //   BABA_DEBUG_LEVEL   -- "debug" for the full trace incl. "plugin initialized"
  //   BABA_DEBUG         -- comma-separated plugin names, or "" to disable
  //   BABA_DEBUG_MAX_LINES -- on-disk rotation cap (default 10000)

// opencode plugins. Renamed `plugin` -> `plugins` for OpenCode 1.19.0 (V2),
// which reads only the plural key and silently drops the singular one.
// `@latest` is fine for personal/dev use; pin a version when
// reproducibility matters.
"plugins": [
    "opencode-vibeguard@latest",
    "opencode-adaptive-thinking@latest",
    "opencode-pty",
    "opencode-autotitle@latest",
    ".opencode/plugins/baba-prompt-system-loader.ts",
    ".opencode/plugins/baba-protocol-enforce.ts",
    ".opencode/plugins/baba-system-reminder-override.ts",
    ".opencode/plugins/baba-bootstrap.ts",
    ".opencode/plugins/baba-convention-review.ts",
    ".opencode/plugins/baba-goal-detect.ts",
    ".opencode/plugins/baba-lock-enforce.ts",
    // memory-worth is a local package in .opencode/packages/memory-worth
    // (referenced in .opencode/package.json). Load it as a package directory.
    ".opencode/packages/memory-worth",
    ".opencode/plugins/adaptive-temperature.ts",
    ".opencode/plugins/multi-model-consensus.ts"
  ],

  // MCP servers mirror the fallback tiers in AGENTS.md, adapted to opencode's
  // schema. Note: opencode interpolates {env:VAR}, NOT ${VAR}.
  // Web search stack: exa (preferred when keyed), g-search (no-key Google MCP), curl (last resort).
  "mcp": {
    // Tier 1 — no keys required
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.80"],
      "timeout": 30000
    },
    "playwright-headless": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.80", "--headless"]
    },
    "g-search": {
      "type": "local",
      "command": ["npx", "-y", "g-search-mcp"]
    },
    "arxiv": {
      "type": "local",
      "command": ["uvx", "arxiv-mcp-server"]
    },
    // Tier 2 — requires env key; omit if key is not set
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": { "x-api-key": "{env:EXA_API_KEY}" }
    },
    // Remote OAuth — no key, one-time browser consent via `opencode mcp auth trello`
    "trello": {
      "type": "remote",
      "url": "https://mcp.trello.com/v1",
      "oauth": {}
    }
  }
}